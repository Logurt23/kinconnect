# Locally these match docker-compose.yml and the Auth emulator (see README); on Cloud Run they are set in
# deploy/service.yaml, with the secrets in Secret Manager.

# Postgres admin connection, for `npm run db:migrate` / `db:reset` only (the app never uses it).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# The password PostgREST logs in with as `authenticator`; db:migrate sets it.
AUTHENTICATOR_PASSWORD=authenticator-local
# PostgREST, and the secret it checks the app's per-request tokens with (32+ characters: openssl rand -hex 32).
POSTGREST_URL=http://127.0.0.1:3001
PGRST_JWT_SECRET=local-dev-jwt-secret-at-least-32-characters-long

# Identity Platform. Locally the Auth emulator accepts any API key; FIREBASE_AUTH_EMULATOR_HOST is local only.
GOOGLE_CLOUD_PROJECT=demo-kinconnect
IDENTITY_PLATFORM_API_KEY=local-emulator-key
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cloud Storage bucket for vault files, listing photos and avatars. GCS_ENDPOINT is local only (fake-gcs-server).
GCS_BUCKET=kinconnect-files
GCS_ENDPOINT=http://127.0.0.1:4443

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dates and times on every page. Any IANA name.
APP_TIMEZONE=America/Chicago

# Google Calendar, read only. Leave blank and the Schedule screen says Google isn't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored Google refresh tokens.
TOKEN_ENCRYPTION_KEY=

# National Weather Service asks every caller to identify itself.
NWS_USER_AGENT="KinConnect family app (you@example.com)"
# Override only to point at a stub in tests.
NWS_BASE_URL=
# Bearer token for /api/cron/weather and /api/cron/calendars. At least 32 characters (openssl rand -hex 32).
CRON_SECRET=
# Development only: let calendar subscribe links point at localhost (the e2e stub). Ignored in production.
ICS_ALLOW_PRIVATE=

# First admin, created by `npm run bootstrap-admin`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
