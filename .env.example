# Supabase. Locally, `npm run db:start` prints these (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar, read only. Leave blank and the Schedule screen says Google isn't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored Google refresh tokens.
TOKEN_ENCRYPTION_KEY=

# National Weather Service asks every caller to identify itself.
NWS_USER_AGENT="Kinroot family app (you@example.com)"
# Bearer token for /api/cron/weather.
CRON_SECRET=

# First admin, created by `npm run bootstrap-admin`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
